# CareerPilot Docker environment template

# Use long alphanumeric passwords because these values are
# embedded inside database connection URLs.
MYSQL_PASSWORD=replace_with_long_alphanumeric_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password

GEMINI_API_KEY=your_gemini_api_key

JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret

AWS_REGION=ap-south-1
MINIO_ROOT_USER=careerpilot-minio
MINIO_ROOT_PASSWORD=replace_with_long_alphanumeric_minio_password
S3_ENDPOINT_URL=http://minio:9000
S3_RESUME_BUCKET=careerpilot-resumes