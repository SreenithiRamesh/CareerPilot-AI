# ==================================================
# CAREERPILOT AI - ENVIRONMENT TEMPLATE
# ==================================================

# ------------------------------
# Gemini
# ------------------------------
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------
# MySQL / SQLAlchemy
# ------------------------------
DATABASE_URL=mysql+pymysql://careerpilot:your_password@127.0.0.1:3306/careerpilot_ai


# ------------------------------
# LangGraph Checkpointer
# ------------------------------
LANGGRAPH_DATABASE_URL=mysql://careerpilot:your_password@127.0.0.1:3306/careerpilot_ai


# ------------------------------
# JWT Authentication
# ------------------------------
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------
# Application
# ------------------------------
APP_ENV=development


# ------------------------------
# AWS - Future Deployment
# ------------------------------
AWS_REGION=ap-south-1
S3_RESUME_BUCKET=your_private_resume_bucket_name