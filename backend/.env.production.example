# ==================================================
# CAREERPILOT AI - PRODUCTION ENVIRONMENT TEMPLATE
# ==================================================
#
# Copy these variable names into the deployment
# platform's secret/environment configuration.
#
# Never commit real credentials.
# Use long alphanumeric database passwords so they
# remain safe when embedded inside connection URLs.


# ------------------------------
# Application
# ------------------------------
APP_ENV=production
LOG_LEVEL=INFO


# ------------------------------
# Gemini
# ------------------------------
GEMINI_API_KEY=replace_with_production_gemini_api_key


# ------------------------------
# MySQL / SQLAlchemy
# ------------------------------
DATABASE_URL=mysql+pymysql://careerpilot:replace_with_database_password@replace_with_database_host:3306/careerpilot_ai


# ------------------------------
# LangGraph MySQL Checkpointer
# ------------------------------
LANGGRAPH_DATABASE_URL=mysql://careerpilot:replace_with_database_password@replace_with_database_host:3306/careerpilot_ai


# ------------------------------
# JWT Authentication
# ------------------------------
JWT_SECRET_KEY=replace_with_a_long_random_production_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------
# CORS
# ------------------------------
# Use the exact HTTPS frontend origin.
# Do not include a trailing slash.
CORS_ORIGINS=https://replace_with_frontend_domain


# ------------------------------
# Private Resume Object Storage
# ------------------------------
AWS_REGION=ap-south-1
S3_RESUME_BUCKET=replace_with_private_resume_bucket_name


# ------------------------------
# Optional S3-Compatible Endpoint
# ------------------------------
# Leave empty when using Amazon S3.
# Set an HTTPS endpoint when using another
# S3-compatible production storage provider.
S3_ENDPOINT_URL=