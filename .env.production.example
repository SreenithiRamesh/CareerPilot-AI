# ==================================================
# CAREERPILOT AI - PRODUCTION VM TEMPLATE
# ==================================================
#
# Copy this file to .env.production on the VM.
# Replace every placeholder only inside the untracked
# .env.production file.
#
# Never commit .env.production.


# ------------------------------
# Application
# ------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=https://replace_with_frontend_domain

# Public backend domain used by Caddy.
# Enter the hostname only—no https:// and no trailing slash.
API_DOMAIN=api.replace_with_backend_domain

# Used only for automatic TLS certificate notices.
ACME_EMAIL=replace_with_contact_email
# ------------------------------
# Gemini
# ------------------------------
GEMINI_API_KEY=replace_with_production_gemini_api_key


# ------------------------------
# MySQL
# ------------------------------
# Use long, different, alphanumeric passwords because
# MYSQL_PASSWORD is embedded inside connection URLs.
MYSQL_PASSWORD=replace_with_long_alphanumeric_database_password
MYSQL_ROOT_PASSWORD=replace_with_different_alphanumeric_root_password


# ------------------------------
# JWT
# ------------------------------
JWT_SECRET_KEY=replace_with_a_long_random_production_jwt_secret


# ------------------------------
# Private S3-Compatible Storage
# ------------------------------
AWS_REGION=ap-south-1
S3_RESUME_BUCKET=careerpilot-resumes

MINIO_ROOT_USER=careerpilot-storage
MINIO_ROOT_PASSWORD=replace_with_long_alphanumeric_storage_password